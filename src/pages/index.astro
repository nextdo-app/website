---
const downloadUrl = "/download/";
const webAppUrl = "https://nextdo-app.157712.xyz";
const sourceUrl = "https://github.com/nextdo-app/nextdo";

const features = [
  {
    number: "01",
    en: "CAPTURE",
    title: "想到了，就先记下来。",
    desc: "把突然出现的灵感、任务和琐碎念头放进收集箱。无需立刻规划，清空大脑，随时回到手头要事。",
    badge: "清空大脑"
  },
  {
    number: "02",
    en: "CLARIFY",
    title: "把模糊变成明确的下一步。",
    desc: "跟随 GTD 厘清向导，判断它是否可以行动。把「有空再做」转化为可以在特定时间、场景直接执行的具体行动。",
    badge: "行动导向"
  },
  {
    number: "03",
    en: "ENGAGE",
    title: "一次，只专注一件事。",
    desc: "根据当下场景与可用时间，聚焦当前最值得完成的事。告别冗长清单带来的反复犹豫与焦虑。",
    badge: "心流专注"
  }
];

const steps = [
  { num: "01", name: "收集", en: "Capture", desc: "捕捉脑海中的每一件事，放入收集箱，清空工作记忆。" },
  { num: "02", name: "厘清", en: "Clarify", desc: "判断它是否可行动？下一步具体动作是什么？两分钟内能否解决？" },
  { num: "03", name: "组织", en: "Organize", desc: "按项目、场景与时间安排分类，放入合适的行动清单。" },
  { num: "04", name: "回顾", en: "Reflect", desc: "定期检视清单与项目进展，保持系统清爽、可信与准确。" },
  { num: "05", name: "执行", en: "Engage", desc: "根据场景、时间与精力，全心投入眼前的这一件要事。" }
];

const pillars = [
  {
    title: "Local-first 本地优先",
    desc: "数据默认存储在本地设备 SQLite，无需依赖云端服务器。毫秒级极速响应，断网依然完全可用。",
    badge: "极致隐私"
  },
  {
    title: "100% 开源透明 (MIT)",
    desc: "代码完全开源，零私有遥测与数据收集。每一行逻辑透明可见，社区驱动共建可信工具。",
    badge: "社区共建"
  },
  {
    title: "多端协同与跨平台",
    desc: "提供 macOS、Windows、Linux、Android 客户端及现代浏览器 Web 版本，随处保持心流节奏。",
    badge: "随处可用"
  }
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f9faf7" />
    <meta name="description" content="Nextdo 是开源、本地优先的极简 GTD 任务管理工具。快速收集、清晰厘清，一次只专注当前最值得做的一件事。" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nextdo" />
    <meta property="og:title" content="Nextdo — 少一点计划，多一点行动" />
    <meta property="og:description" content="开源、本地优先的极简 GTD 任务管理工具。支持 macOS、Windows、Linux、Android 与网页版。" />
    <meta property="og:url" content="https://nextdo.157712.xyz" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/styles.css" />
    <title>Nextdo — 少一点计划，多一点行动</title>
  </head>
  <body id="top">
    <!-- Sticky Glass Header -->
    <div class="site-header-container">
      <header class="site-header wrap">
        <a class="brand" href="/" aria-label="Nextdo 首页">
          <span class="brand-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <line x1="12" y1="3" x2="12" y2="21" />
              <line x1="3" y1="12" x2="21" y2="12" />
              <line x1="5.6" y1="5.6" x2="18.4" y2="18.4" />
              <line x1="18.4" y1="5.6" x2="5.6" y2="18.4" />
            </svg>
          </span>
          nextdo<span class="dot">.</span>
        </a>

        <nav class="nav-links" aria-label="主导航">
          <a href="#features">产品亮点</a>
          <a href="#workflow">GTD 流程</a>
          <a href="#philosophy">本地与开源</a>
          <a href={downloadUrl}>客户端下载</a>
          <a href={sourceUrl} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </nav>

        <div class="nav-actions">
          <a class="nav-text-btn" href={webAppUrl} target="_blank" rel="noopener noreferrer">网页版 ↗</a>
          <a class="nav-cta" href={downloadUrl}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <polyline points="7 10 12 15 17 10" />
              <line x1="12" y1="15" x2="12" y2="3" />
            </svg>
            下载客户端
          </a>
        </div>

        <!-- Mobile hamburger -->
        <button class="mobile-nav-toggle" id="mobile-toggle" aria-label="展开菜单" aria-expanded="false">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
        </button>
      </header>

      <!-- Mobile Dropdown -->
      <div class="mobile-menu-drawer" id="mobile-drawer">
        <a href="#features" class="mobile-link">产品亮点</a>
        <a href="#workflow" class="mobile-link">GTD 流程</a>
        <a href="#philosophy" class="mobile-link">本地与开源</a>
        <a href={downloadUrl} class="mobile-link">客户端下载</a>
        <a href={webAppUrl} target="_blank" rel="noopener noreferrer" class="mobile-link">打开网页版 ↗</a>
        <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="mobile-link">GitHub 源码 ↗</a>
      </div>
    </div>

    <main>
      <!-- Hero Section -->
      <section class="hero wrap">
        <div class="hero-copy">
          <div class="kicker">
            <span class="kicker-pill">
              <span class="kicker-dot" aria-hidden="true"></span>
              YOUR NEXT ACTION, MADE CLEAR
            </span>
          </div>
          <h1>少一点计划。<br /><em>多一点行动。</em></h1>
          <p>
            待办事项不该成为新的负担。Nextdo 将经典 GTD（Getting Things Done）工作流精炼简化，帮你快速捕捉灵感、厘清任务，并全心专注此刻真正值得完成的下一步。
          </p>

          <div class="hero-buttons">
            <a class="btn btn-primary" href={downloadUrl}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <polyline points="7 10 12 15 17 10" />
                <line x1="12" y1="15" x2="12" y2="3" />
              </svg>
              立即下载客户端 ↓
            </a>
            <a class="btn btn-secondary" href={webAppUrl} target="_blank" rel="noopener noreferrer">
              免安装在线体验 ↗
            </a>
          </div>

          <div class="hero-benefits">
            <span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12" />
              </svg>
              100% 开源免费 (MIT)
            </span>
            <span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12" />
              </svg>
              本地优先数据掌控
            </span>
            <span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12" />
              </svg>
              全平台跨设备支持
            </span>
          </div>
        </div>

        <!-- Hero App Visual Mockup -->
        <div class="hero-art-wrapper">
          <div class="hero-art-glow" aria-hidden="true"></div>
          <div class="mock-window">
            <div class="mock-header">
              <div class="mock-traffic-lights" aria-hidden="true">
                <span class="tl-red"></span>
                <span class="tl-yellow"></span>
                <span class="tl-green"></span>
              </div>
              <div class="mock-title">Nextdo — 专注每一个当下</div>
            </div>

            <div class="mock-content">
              <!-- Sidebar -->
              <div class="mock-sidebar">
                <div class="mock-side-item active">
                  <span>● 当下要事</span>
                  <span class="badge">1</span>
                </div>
                <div class="mock-side-item">
                  <span>▤ 收集箱</span>
                  <span class="badge">4</span>
                </div>
                <div class="mock-side-item">
                  <span>▦ 下一步行动</span>
                  <span class="badge">8</span>
                </div>
                <div class="mock-side-item">
                  <span>▧ 进行中项目</span>
                  <span class="badge">3</span>
                </div>
                <div class="mock-side-item">
                  <span>◷ 等待 / 稍后</span>
                  <span class="badge">2</span>
                </div>
                <div class="mock-sidebar-footer">
                  <span>⌘ + K 快捷呼出</span>
                </div>
              </div>

              <!-- Main Panel -->
              <div class="mock-main">
                <div class="mock-greeting">
                  <span>TODAY'S FOCUS</span>
                  <span class="mock-date">星期三 · 保持专注</span>
                </div>
                <h3>今天，从这里开始。</h3>
                <p class="mock-main-desc">不急于完成所有清单，先做好这一件。</p>

                <!-- Current Recommended Action Card -->
                <div class="mock-focus-card">
                  <div class="mock-focus-top">
                    <span class="mock-focus-tag">当前建议行动</span>
                    <span class="mock-focus-time">⏱ 约 25 分钟</span>
                  </div>
                  <div class="mock-focus-title">整理下一阶段产品核心路线图</div>
                  <div class="mock-focus-sub">产品战略 · 场景：电脑前 · 精力充沛</div>
                  <div class="mock-focus-action">
                    <span>专注执行这一件事</span>
                    <span class="mock-play-btn">进入心流 ▶</span>
                  </div>
                </div>

                <!-- Next Actions List -->
                <div class="mock-list-label">
                  <span>后续候选队列</span>
                  <span>今日进展 2 / 5</span>
                </div>
                <div class="mock-item">
                  <div class="mock-item-left">
                    <span class="mock-check" aria-hidden="true"></span>
                    <span>回复项目版本发布相关邮件</span>
                  </div>
                  <small>10 分钟</small>
                </div>
                <div class="mock-item">
                  <div class="mock-item-left">
                    <span class="mock-check" aria-hidden="true"></span>
                    <span>阅读并审阅架构演进方案</span>
                  </div>
                  <small>15 分钟</small>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Manifesto / GTD Sequence Bar -->
      <section class="manifesto">
        <div class="wrap manifesto-flow">
          <div class="manifesto-step">
            <strong>01</strong>
            <span>收集</span>
            <small>CAPTURE</small>
          </div>
          <span class="manifesto-arrow" aria-hidden="true">→</span>
          <div class="manifesto-step">
            <strong>02</strong>
            <span>厘清</span>
            <small>CLARIFY</small>
          </div>
          <span class="manifesto-arrow" aria-hidden="true">→</span>
          <div class="manifesto-step">
            <strong>03</strong>
            <span>组织</span>
            <small>ORGANIZE</small>
          </div>
          <span class="manifesto-arrow" aria-hidden="true">→</span>
          <div class="manifesto-step">
            <strong>04</strong>
            <span>回顾</span>
            <small>REFLECT</small>
          </div>
          <span class="manifesto-arrow" aria-hidden="true">→</span>
          <div class="manifesto-step">
            <strong>05</strong>
            <span>执行</span>
            <small>ENGAGE</small>
          </div>
        </div>
      </section>

      <!-- Core Features Section -->
      <section class="section wrap" id="features">
        <div class="section-lead">
          <div class="kicker">
            <span class="kicker-pill">MADE FOR CLARITY</span>
          </div>
          <h2>从想到，到做到。<br /><em>每一步都自然轻松。</em></h2>
          <p>真正的生产力不是在无休止的清单里打转，而是在每次开始工作时，都不再为「下一步该做什么」而踌躇。</p>
        </div>

        <div class="feature-grid">
          {features.map(f => (
            <article class="feature-card">
              <div class="feature-header">
                <div class="feature-icon-box" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    {f.number === "01" && (
                      <>
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                        <line x1="12" y1="18" x2="12" y2="12" />
                        <line x1="9" y1="15" x2="15" y2="15" />
                      </>
                    )}
                    {f.number === "02" && (
                      <>
                        <polygon points="12 2 2 7 12 12 22 7 12 2" />
                        <polyline points="2 17 12 22 22 17" />
                        <polyline points="2 12 12 17 22 12" />
                      </>
                    )}
                    {f.number === "03" && (
                      <>
                        <circle cx="12" cy="12" r="10" />
                        <polygon points="10 8 16 12 10 16 10 8" />
                      </>
                    )}
                  </svg>
                </div>
                <span class="feature-badge">{f.number} / {f.en}</span>
              </div>
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- GTD Workflow Section -->
      <section class="workflow-section" id="workflow">
        <div class="wrap workflow-layout">
          <div class="workflow-left">
            <div class="kicker">
              <span class="kicker-pill">SIMPLE BY DESIGN</span>
            </div>
            <h2>一个自然的流程，<br />让行动更容易启动。</h2>
            <p>
              传统清单常让你陷入整理的泥潭。Nextdo 严格还原 GTD 核心精髓：先捕捉、后厘清，按可用场景与精力推荐下一步。你只需迈出第一步。
            </p>
            <div style="display: flex; gap: 12px; flex-wrap: wrap;">
              <a class="btn btn-primary" href={downloadUrl}>获取 Nextdo 客户端 ↓</a>
              <a class="btn btn-secondary" href={sourceUrl} target="_blank" rel="noopener noreferrer">在 GitHub 上了解源码 ↗</a>
            </div>
          </div>

          <ol class="workflow-steps">
            {steps.map(step => (
              <li class="workflow-step-card">
                <span class="step-num">{step.num}</span>
                <div class="step-info">
                  <strong>{step.name} <span style="font-weight: 500; color: var(--text-muted); font-size: 13px;">({step.en})</span></strong>
                  <small>{step.desc}</small>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- Local-First & Open-Source Section -->
      <section class="opensource-section wrap" id="philosophy">
        <div class="opensource-grid">
          <div class="opensource-left">
            <div class="kicker">
              <span class="kicker-pill">BUILT TO STAY YOURS</span>
            </div>
            <h2>你的任务与生活，<br />理应由你掌控。</h2>
            <p>
              我们坚信生产力工具应当尊重你的隐私与数据主权。Nextdo 绝不上传私有数据用于广告画像，断开网络也能极速管理你的生活，代码完全开源，经得起长期推敲。
            </p>
            <a class="btn btn-secondary" href={sourceUrl} target="_blank" rel="noopener noreferrer">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
              </svg>
              查看 GitHub 仓库与更新记录 ↗
            </a>
          </div>

          <div class="opensource-cards">
            {pillars.map(p => (
              <div class="pillar-card">
                <div class="pillar-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    {p.title.includes("Local") && (
                      <>
                        <ellipse cx="12" cy="5" rx="9" ry="3" />
                        <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" />
                        <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
                      </>
                    )}
                    {p.title.includes("开源") && (
                      <>
                        <polyline points="16 18 22 12 16 6" />
                        <polyline points="8 6 2 12 8 18" />
                      </>
                    )}
                    {p.title.includes("多端") && (
                      <>
                        <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
                        <line x1="8" y1="21" x2="16" y2="21" />
                        <line x1="12" y1="17" x2="12" y2="21" />
                      </>
                    )}
                  </svg>
                </div>
                <div>
                  <strong>{p.title}</strong>
                  <p>{p.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Bottom Callout Section -->
      <section class="wrap callout-wrapper">
        <div class="callout">
          <div class="kicker">
            <span class="kicker-pill">THE NEXT STEP IS SIMPLE</span>
          </div>
          <h2>你的下一步，<br />从这里开始。</h2>
          <p>
            不必等到万事俱备才开始管理。打开 Nextdo，写下脑海里的第一件事，把生活与工作重新梳理清晰。
          </p>
          <div class="callout-buttons">
            <a class="btn btn-light" href={downloadUrl}>
              立即下载 Nextdo 客户端 ↓
            </a>
            <a class="btn btn-secondary" style="background: rgba(255,255,255,0.15); border-color: rgba(255,255,255,0.3); color: #fff;" href={webAppUrl} target="_blank" rel="noopener noreferrer">
              免安装在线打开 ↗
            </a>
          </div>
        </div>
      </section>
    </main>

    <!-- Global Footer -->
    <footer class="site-footer-container">
      <div class="wrap">
        <div class="footer-top">
          <div class="footer-brand">
            <a class="brand" href="#top" aria-label="回到顶部">
              <span class="brand-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                  <line x1="12" y1="3" x2="12" y2="21" />
                  <line x1="3" y1="12" x2="21" y2="12" />
                  <line x1="5.6" y1="5.6" x2="18.4" y2="18.4" />
                  <line x1="18.4" y1="5.6" x2="5.6" y2="18.4" />
                </svg>
              </span>
              nextdo<span class="dot">.</span>
            </a>
            <p>为真正重要的事情，留出更多的时间与心流空间。开源、本地优先的极简 GTD 任务管理工具。</p>
          </div>

          <div class="footer-col">
            <h4>产品</h4>
            <ul>
              <li><a href="#features">功能亮点</a></li>
              <li><a href="#workflow">GTD 工作流程</a></li>
              <li><a href={downloadUrl}>安装包下载</a></li>
              <li><a href={webAppUrl} target="_blank" rel="noopener noreferrer">Web 网页版</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h4>客户端</h4>
            <ul>
              <li><a href={`${downloadUrl}#platforms`}>macOS (Apple Silicon / Intel)</a></li>
              <li><a href={`${downloadUrl}#platforms`}>Windows 10 / 11</a></li>
              <li><a href={`${downloadUrl}#platforms`}>Android APK</a></li>
              <li><a href={`${downloadUrl}#platforms`}>Linux (AppImage / DEB)</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h4>开源与社区</h4>
            <ul>
              <li><a href={sourceUrl} target="_blank" rel="noopener noreferrer">GitHub 仓库</a></li>
              <li><a href={`${sourceUrl}/releases`} target="_blank" rel="noopener noreferrer">更新发布日志</a></li>
              <li><a href={`${sourceUrl}/issues`} target="_blank" rel="noopener noreferrer">问题与反馈</a></li>
              <li><a href={`${sourceUrl}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer">MIT 开源许可</a></li>
            </ul>
          </div>
        </div>

        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} Nextdo Project. Released under the MIT License.</span>
          <div class="footer-bottom-links">
            <a href={sourceUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href={webAppUrl} target="_blank" rel="noopener noreferrer">Web App</a>
            <a href="#top">回到顶部 ↑</a>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      const toggle = document.getElementById("mobile-toggle");
      const drawer = document.getElementById("mobile-drawer");
      if (toggle && drawer) {
        toggle.addEventListener("click", () => {
          const isOpen = drawer.classList.toggle("open");
          toggle.setAttribute("aria-expanded", String(isOpen));
        });
        document.querySelectorAll(".mobile-link").forEach(link => {
          link.addEventListener("click", () => {
            drawer.classList.remove("open");
            toggle.setAttribute("aria-expanded", "false");
          });
        });
      }
    </script>
  </body>
</html>
