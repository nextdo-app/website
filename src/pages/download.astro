        suffix: "amd64.deb",
        type: ".deb",
        size: "7.5 MB",
        recommended: false
      }
    ]
  }
];

const getDirectUrl = (tag, suffix) =>
  `https://github.com/nextdo-app/nextdo/releases/download/${tag}/Nextdo_${tag.replace(/^v/, "")}_${suffix}`;
