              <li><a href={webAppUrl} target="_blank" rel="noopener noreferrer">Web 网页版</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h4>下载快捷入口</h4>
            <ul>
              <li><a href="#card-macos">macOS 客户端</a></li>
              <li><a href="#card-windows">Windows 客户端</a></li>
              <li><a href="#card-android">Android 客户端</a></li>
              <li><a href="#card-linux">Linux 客户端</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h4>开源与社区</h4>
            <ul>
              <li><a href={sourceUrl} target="_blank" rel="noopener noreferrer">GitHub 仓库</a></li>
              <li><a href={`${sourceUrl}/releases`} target="_blank" rel="noopener noreferrer">发布日志</a></li>
              <li><a href={`${sourceUrl}/issues`} target="_blank" rel="noopener noreferrer">提交 Issue</a></li>
              <li><a href={`${sourceUrl}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer">MIT 开源协议</a></li>
            </ul>
          </div>
        </div>

        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} Nextdo Project. Released under the MIT License.</span>
          <div class="footer-bottom-links">
            <a href={sourceUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href={webAppUrl} target="_blank" rel="noopener noreferrer">Web App</a>
            <a href="#top">回到顶部 ↑</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Client-Side Script: OS Detection & Live Release Update -->
    <script is:inline>
      (() => {
        const compareReleases = (a, b) => {
          const parse = (v) => {
            const m = (v || "").match(/^v?(\d+)\.(\d+)\.(\d+)(?:-([a-zA-Z0-9.]+))?/);
            if (!m) return null;
            const parts = (m[4] || "").split(".").map(p => /^\d+$/.test(p) ? parseInt(p, 10) : p);
            return {
              major: parseInt(m[1], 10),
              minor: parseInt(m[2], 10),
              patch: parseInt(m[3], 10),
              prerelease: m[4] ? parts : null
            };
          };
          const pa = parse(a.tag_name || a.version);
          const pb = parse(b.tag_name || b.version);
          if (pa && pb) {
            if (pb.major !== pa.major) return pb.major - pa.major;
            if (pb.minor !== pa.minor) return pb.minor - pa.minor;
            if (pb.patch !== pa.patch) return pb.patch - pa.patch;
            if (!pb.prerelease && pa.prerelease) return 1;
            if (pb.prerelease && !pa.prerelease) return -1;
            if (pb.prerelease && pa.prerelease) {
              const len = Math.max(pb.prerelease.length, pa.prerelease.length);
              for (let i = 0; i < len; i++) {
                const pA = pa.prerelease[i];
                const pB = pb.prerelease[i];
                if (pA === undefined) return 1;
                if (pB === undefined) return -1;
                if (typeof pA === "number" && typeof pB === "number") {
                  if (pB !== pA) return pB - pA;
                } else {
                  const c = String(pB).localeCompare(String(pA), undefined, { numeric: true });
                  if (c !== 0) return c;
                }
              }
            }
          } else {
            const cmp = (b.tag_name || b.version || "").localeCompare(a.tag_name || a.version || "", undefined, { numeric: true });
            if (cmp !== 0) return cmp;
          }
          return new Date(b.published_at || b.created_at || 0) - new Date(a.published_at || a.created_at || 0);
        };

        // Fallback release definitions
        const fallbackReleases = {
          stable: {
            version: "v0.1.7",
            tag: "v0.1.7"
          },
          beta: {
            version: "v0.1.9-beta.11",
            tag: "v0.1.9-beta.11"
          }
        };

        let currentChannel = "stable";
        try {
          const urlParams = new URLSearchParams(window.location.search);
          if (urlParams.get("channel") === "beta" || window.location.hash === "#beta") {
            currentChannel = "beta";
          }
        } catch {}

        let activeReleases = { ...fallbackReleases };

        const makeDownloadUrl = (ver, suffix) => {
          const cleanVer = ver.replace(/^v/, "");
          return `https://github.com/nextdo-app/nextdo/releases/download/${ver}/Nextdo_${cleanVer}_${suffix}`;
        };

        // Render download buttons based on current channel
        function updateDownloadLinks() {
          const currentRel = activeReleases[currentChannel];
          const currentVer = currentRel?.version || (currentChannel === "stable" ? "v0.1.7" : "v0.1.9-beta.11");

          // Update Channel Tabs
          document.querySelectorAll("[data-channel]").forEach(btn => {
            const isMatch = btn.dataset.channel === currentChannel;
            btn.setAttribute("aria-pressed", String(isMatch));
          });

          // Update Notes
          const noteEl = document.getElementById("channel-note");
          if (noteEl) {
            noteEl.textContent = currentChannel === "stable"
              ? "稳定版推荐日常使用，经过充分验证；测试版包含最新特性与修复。"
              : "测试版包含最新改动与尝鲜特性，更新更频繁。重要数据建议定期备份。";
          }

          // Update each installer link in cards
          document.querySelectorAll(".installer-btn").forEach(btn => {
            const suffix = btn.dataset.suffix;
            if (!suffix) return;
            const targetUrl = makeDownloadUrl(currentVer, suffix);
            const assets = currentRel?.assets;
            if (Array.isArray(assets) && assets.length > 0) {
              const matchedAsset = assets.find(a => a.name.endsWith(`_${suffix}`) || a.name === suffix);
              if (matchedAsset) {
                btn.href = matchedAsset.download_url || targetUrl;
                btn.classList.remove("unavailable");
                btn.removeAttribute("aria-disabled");
                btn.title = "";
              } else {
                btn.classList.add("unavailable");
                btn.setAttribute("aria-disabled", "true");
                btn.removeAttribute("href");
                btn.title = `${currentVer} 暂未提供该格式安装包`;
              }
            } else {
              btn.href = targetUrl;
              btn.classList.remove("unavailable");
              btn.removeAttribute("aria-disabled");
              btn.title = "";
            }
          });

          // Refresh OS Recommendation card with current version
          detectAndSetRecommendation(currentVer);
        }
        // Detect user OS
        function detectAndSetRecommendation(version) {
          const ua = navigator.userAgent || "";
          const platform = navigator.platform || "";
          let os = "other";
          let label = "适用你的系统";
          let filename = "";
          let desc = "";

          const isMac = /Macintosh|MacIntel|MacPPC|Mac68K/i.test(ua) || /Mac/i.test(platform);
          const isWin = /Win32|Win64|Windows|WinCE/i.test(ua) || /Win/i.test(platform);
          const isAndroid = /Android/i.test(ua);
          const isIOS = /iPhone|iPad|iPod/i.test(ua);
          const isLinux = /Linux/i.test(ua) && !isAndroid;

          if (isMac) {
            os = "mac";
            // Check for Apple Silicon
            const isAppleSilicon = /ARM/i.test(navigator.userAgentData?.architecture || "") ||
              (navigator.maxTouchPoints > 1 && !/iPhone|iPad/i.test(ua)) || true; // Most Macs today
            if (isAppleSilicon) {
              label = "macOS (Apple Silicon)";
              filename = "aarch64.dmg";
              desc = "适用于搭载 M1 / M2 / M3 / M4 芯片的 MacBook、iMac、Mac mini";
            } else {
              label = "macOS (Intel)";
              filename = "x64.dmg";
              desc = "适用于搭载 Intel 处理器的 Mac 设备";
            }
          } else if (isWin) {
            os = "windows";
            label = "Windows (x64)";
            filename = "x64-setup.exe";
            desc = "适用于 64 位 Windows 10 与 Windows 11";
          } else if (isAndroid) {
            os = "android";
            label = "Android (ARM64)";
            filename = "android_arm64-v8a.apk";
            desc = "适用于绝大多数现代 Android 手机与平板设备";
          } else if (isIOS) {
            os = "ios";
            label = "iPhone / iPad (Web App)";
            desc = "iOS 暂未上架 App Store，可直接使用网页版并「添加到主屏幕」";
          } else if (isLinux) {
            os = "linux";
            label = "Linux (AppImage)";
            filename = "amd64.AppImage";
            desc = "适用于 Ubuntu, Debian, Fedora, Arch 等主流发行版";
          }

          const titleEl = document.getElementById("os-title");
          const descEl = document.getElementById("os-desc");
          const btnEl = document.getElementById("os-btn");
          const btnVerEl = document.getElementById("os-btn-ver");

          if (os === "ios") {
            if (titleEl) titleEl.textContent = label;
            if (descEl) descEl.textContent = desc;
            if (btnEl) {
              btnEl.textContent = "打开免安装网页版 ↗";
              btnEl.href = "https://nextdo-app.157712.xyz";
              btnEl.target = "_blank";
            }
          } else if (filename) {
            if (titleEl) titleEl.textContent = `推荐下载：${label}`;
            if (descEl) descEl.textContent = desc;
            if (btnEl) {
              btnEl.href = makeDownloadUrl(version, filename);
              btnEl.innerHTML = `一键下载 ${version} ↓`;
            }
          } else {
            if (titleEl) titleEl.textContent = "选择适合你设备的安装包";
            if (descEl) descEl.textContent = "支持 macOS、Windows、Linux、Android 与浏览器在线使用";
            if (btnEl) {
              btnEl.href = "#platforms";
              btnEl.innerHTML = `浏览全部平台 ↓`;
            }
          }
        }

        // Setup channel tab clicks
        document.querySelectorAll("[data-channel]").forEach(btn => {
          btn.addEventListener("click", () => {
            currentChannel = btn.dataset.channel;
            updateDownloadLinks();
          });
        });

        // Initialize OS detection immediately
        updateDownloadLinks();

        // Fetch latest version info from API or GitHub
        (async () => {
          const statusEl = document.getElementById("sync-status");
          try {
            // First try internal API endpoint
            let data = null;
            try {
              const res = await fetch("/api/releases");
              if (res.ok) data = await res.json();
            } catch {}

            // If internal endpoint not responding, fetch GitHub directly
            if (!data || !data.stable) {
              const [stRes, recRes] = await Promise.all([
                fetch("https://api.github.com/repos/nextdo-app/nextdo/releases/latest"),
                fetch("https://api.github.com/repos/nextdo-app/nextdo/releases?per_page=20")
              ]);
              if (stRes.ok && recRes.ok) {
                const st = await stRes.json();
                const rec = await recRes.json();
                const prereleases = Array.isArray(rec)
                  ? rec
                      .filter(r => !r.draft && r.prerelease && Array.isArray(r.assets) && r.assets.some(a => a.name.endsWith(".dmg") || a.name.endsWith(".exe") || a.name.endsWith(".apk") || a.name.endsWith(".AppImage")))
                      .sort(compareReleases)
                  : [];
                const bt = prereleases[0] || st;
                data = {
                  stable: { version: st.tag_name, assets: st.assets || [] },
                  beta: { version: bt.tag_name, assets: bt.assets || [] }
                };
              }
            }

            if (data && data.stable?.version) {
              activeReleases.stable = {
                version: data.stable.version,
                tag: data.stable.version,
                assets: data.stable.assets || []
              };
              const stableTag = document.getElementById("stable-tag");
              if (stableTag) stableTag.textContent = data.stable.version;

              if (data.beta?.version) {
                activeReleases.beta = {
                  version: data.beta.version,
                  tag: data.beta.version,
                  assets: data.beta.assets || []
                };
                const betaTag = document.getElementById("beta-tag");
                if (betaTag) betaTag.textContent = data.beta.version;
              }

              if (statusEl) {
                statusEl.textContent = `✓ 已同步最新官方发布 (稳定版 ${data.stable.version} / 测试版 ${data.beta?.version || activeReleases.beta.version})，支持高速直接下载。`;
              }
              updateDownloadLinks();
            }
          } catch {
            if (statusEl) {
              statusEl.textContent = `✓ 当前为最新稳定版本 (${fallbackReleases.stable.version})，点击即可开始高速下载。`;
            }
          }
        })();

        // Mobile drawer toggle
        const toggle = document.getElementById("mobile-toggle");
        const drawer = document.getElementById("mobile-drawer");
        if (toggle && drawer) {
          toggle.addEventListener("click", () => {
            const isOpen = drawer.classList.toggle("open");
            toggle.setAttribute("aria-expanded", String(isOpen));
          });
          document.querySelectorAll(".mobile-link").forEach(link => {
            link.addEventListener("click", () => {
              drawer.classList.remove("open");
              toggle.setAttribute("aria-expanded", "false");
            });
          });
        }
      })();
    </script>
  </body>
</html>
